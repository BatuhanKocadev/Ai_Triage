# --- Yerel LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Veritabani ---
DATABASE_URL=postgresql+psycopg2://triage:triage@localhost:5432/ai_triage

# --- Kimlik dogrulama ---
# UYARI: Asagidaki anahtar ornektir. Uretimde MUTLAKA degistirin.
# Uretmek icin: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=buraya-rastgele-64-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Vektor veritabani ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Guvenlik (Gun 21) ---
# Iki sayac da RATE_LIMIT_PENCERE_SN saniyelik kayan pencerede sayilir,
# ama anahtarlari farklidir (10 Agustos 2026 duzeltmesi).
# RATE_LIMIT_GENEL: baglanan uc noktanin IP'si basina kabul edilen istek sayisi.
#   NOT: Streamlit backend'i sunucu tarafindan cagirdigi icin tum arayuz trafigi
#   tek IP'de, yani tek kovada toplanir; sinir kullanici basina degil, arayuzun
#   tamami icin gecerlidir.
# RATE_LIMIT_GIRIS: KULLANICI ADI basina ve yalnizca BASARISIZ giris denemeleri
#   sayilir; basarili giris kota tuketmez.
RATE_LIMIT_GENEL=30
RATE_LIMIT_GIRIS=5
RATE_LIMIT_PENCERE_SN=60
# Dosya yukleme sinirlari.
MAX_UPLOAD_MB=10
IZINLI_UZANTILAR=pdf,docx,txt
# CORS: virgulle ayrilmis izinli origin listesi.
CORS_ORIGINS=http://localhost:8501
