# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/  
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDEs and editors
.vscode/
.idea/

# Local env files (Secrets)
.env
.env.*
!.env.example

# Logs
*.log
hata_logu.txt

# Araç durumu (Serena MCP proje önbelleği — makineye özel, paylaşılmaz)
.serena/

# Test artıkları: pytest-cov'un ham veri dosyası ve pytest önbelleği,
# her koşuda yeniden üretilir — sürüm kontrolüne girmemeli.
.coverage
.coverage.*
.pytest_cache/

# Claude Code worktree'leri: depo içinde duran ayrı çalışma ağaçları, asla
# commit'lenmemeli. .claude/ altındaki diğer dosyalar (ayarlar) paylaşılabilir.
.claude/worktrees/
# Yerel git worktree kökü (gun24-prompt-olcum vb.); çalışma ağacı commit'lenmez.
.worktrees/

# Gün 23 değerlendirme seti ses kayıtları: kullanıcının kendi sesi, yani kişisel
# veri — public depoya girmez. Senaryo metinleri (JSON) commit'lenir, ses girmez.
degerlendirme/ses/
# Kosum ortasinda cokerse kaybolmasin diye her senaryodan sonra yazilan ara
# dosyalar (K15). Kosum tamamlaninca icerikleri nihai <tarih>.json raporunda
# zaten var; her kosumda yeniden uretildikleri icin surumlenmiyorlar.
degerlendirme/sonuclar/*-ham.json
